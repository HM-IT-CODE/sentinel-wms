# =====================================================================
# SentinelWMS — Example environment file
# Copy this to ".env" and fill in your own values. NEVER commit ".env".
# =====================================================================

# --- Database (SQL Server source) ---
# Format: sqlserver://user:password@host:port/database?trust_server_certificate=true
DATABASE_URL=sqlserver://USER:PASSWORD@localhost:1433/WMS_SENTINEL_DEMO?trust_server_certificate=true

# --- Fivetran API (partner integration) ---
# Generate a System Key in Fivetran (Account Settings -> System Keys)
# with policy: [{ "resource_type": "CONNECTOR", "access_level": "MANAGE" }]
FIVETRAN_API_KEY=ft_your_key_here
FIVETRAN_API_SECRET=your_secret_here

# The Fivetran connector id this agent monitors/manages
FIVETRAN_CONNECTOR_ID=your_connector_id_here

# --- Server ---
# Port for SSE transport mode (optional, default 3000)
PORT=3000
